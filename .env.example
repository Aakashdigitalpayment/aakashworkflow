# Supabase — required. Copy this file to .env and fill in your project values.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for the email-confirmation redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# ---------------------------------------------------------------------------
# Local development helpers — leave unset in production.
# ---------------------------------------------------------------------------

# Set to "true" to show the demo-account autofill table on the login screen.
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false

# Passwords for the demo accounts created by
# supabase/migrations/20260916171000_dev_seed_data.sql.
# These are read at build time, so only set them in a local/staging env.
NEXT_PUBLIC_DEMO_CEO_PASSWORD=
NEXT_PUBLIC_DEMO_MANAGER_PASSWORD=
NEXT_PUBLIC_DEMO_DEPT_HEAD_PASSWORD=
NEXT_PUBLIC_DEMO_OFFICER_PASSWORD=
NEXT_PUBLIC_DEMO_EMPLOYEE_PASSWORD=
NEXT_PUBLIC_DEMO_AUDITOR_PASSWORD=
